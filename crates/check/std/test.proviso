// `std.test` (STD.md).
use std.fs { Dir, Path, FsError }

/// A directory tree in memory, for tests (REFERENCE §9.6). Copies of it share its files. It
/// reads a path as the runtime's `Dir` does, and keys each file by its path in that form. A
/// directory is any path that a key continues with `/`, the root, `""`, is always one, and an
/// empty one is held by the key that is its path and a `/` (OPEN_QUESTIONS P5).
pub cap record MemDir {
    state files: Map[Path, Text]
}

/// What a path names in a `MemDir`.
enum Place {
    File
    Dir
    /// A path whose part before the last is a file.
    Through
    /// A missing path in a directory that exists.
    Missing
    /// A path whose directory is missing too.
    Orphan
}

impl MemDir {
    /// A `Dir` that holds `files`, each keyed by its path. Two paths with one normal form are
    /// one file, which holds the later text. A path that ends in `/` is a directory, and its
    /// text is ignored. A path that leaves the root, or goes through another file, holds
    /// nothing, and neither does the root.
    pub fn with_files(files: Map[Text, Text]) -> Dir[read, list, write, create, delete] {
        var paths: Map[Path, Text] = [:]
        for (path, text) in files {
            if MemDir.normal(Path(path)) is Some((key, dir)) and not key.value.is_empty() {
                let _ = paths.set(key: if dir { Path(f"{key.value}/") } else { key }, value: text)
            }
        }
        var kept: Map[Path, Text] = [:]
        for (path, text) in paths {
            if not MemDir.through(files: paths, path: path) {
                let _ = kept.set(key: path, value: text)
            }
        }
        return Dir.of(MemDir(files: kept))
    }

    /// The directory `path` is in, or `""` for the root.
    fn parent(path: Path) -> Text {
        var before = ""
        var rest = path.value
        while rest.split_once("/") is Some((part, after)) {
            before = if before.is_empty() { part } else { f"{before}/{part}" }
            rest = after
        }
        return before
    }

    /// Whether a part of `path` before the last is a file.
    fn through(files: Map[Path, Text], path: Path) -> Bool {
        var before = ""
        var rest = path.value
        while rest.split_once("/") is Some((part, after)) {
            before = if before.is_empty() { part } else { f"{before}/{part}" }
            if files.contains_key(Path(before)) {
                return true
            }
            rest = after
        }
        return false
    }

    /// `path` with `.` and empty parts dropped and each `..` taking away the part before it,
    /// and whether it ends in `/` or `/.`, which names a directory. `None` when `path` is
    /// absolute or a `..` climbs above the root.
    fn normal(path: Path) -> Option[(Path, Bool)] {
        if path.value.starts_with("/") {
            return None
        }
        var given: List[Text] = []
        var rest = path.value
        while rest.split_once("/") is Some((part, after)) {
            given.push(part)
            rest = after
        }
        given.push(rest)
        var parts: List[Text] = []
        for part in given {
            if part == ".." {
                if parts.pop() is None {
                    return None
                }
            } else if not part.is_empty() and part != "." {
                parts.push(part)
            }
        }
        let last = given[given.len() - 1]
        let dir = given.len() > 1 and (last.is_empty() or last == ".")
        var out = ""
        for (i, part) in parts.enumerate() {
            out = if i == 0 { part } else { f"{out}/{part}" }
        }
        return Some((Path(out), dir))
    }

    /// What `path`, in normal form, names among `files`. Only a path that is no file, and goes
    /// through none, scans them all.
    fn place(files: Map[Path, Text], path: Path) -> Place {
        if path.value.is_empty() {
            return Place.Dir
        }
        if files.contains_key(path) {
            return Place.File
        }
        if MemDir.through(files: files, path: path) {
            return Place.Through
        }
        let parent = MemDir.parent(path)
        let (prefix, inside) = (f"{path.value}/", f"{parent}/")
        var in_dir = parent.is_empty()
        for (file, _) in files {
            if file.value.starts_with(prefix) {
                return Place.Dir
            }
            in_dir = in_dir or file.value.starts_with(inside)
        }
        return if in_dir { Place.Missing } else { Place.Orphan }
    }

    /// `given` in normal form, and what it names, or `PermissionDenied` when it leaves the root.
    fn find(files: Map[Path, Text], given: Path) -> (Path, Bool, Place) fails FsError {
        let (path, dir) = MemDir.normal(given) else fail FsError.PermissionDenied(path: given)
        return (path, dir, MemDir.place(files: files, path: path))
    }

    /// The file `given` names, which may be missing, or why it can't be a file.
    fn file(files: Map[Path, Text], given: Path) -> Path fails FsError {
        let (path, dir, place) = try MemDir.find(files: files, given: given)
        check not dir else fail FsError.Other(message: f"`{given.value}` names a directory")
        return match place {
            Place.Dir => fail FsError.Other(message: f"`{given.value}` is a directory")
            Place.Through => fail FsError.Other(message: f"`{given.value}` goes through a file")
            Place.Orphan => fail FsError.NotFound(path: given)
            Place.File => path
            Place.Missing => path
        }
    }

    /// `names` in the order of their bytes, by merging, since a list has no `sort` yet.
    fn sorted(names: List[Text]) -> List[Text] {
        if names.len() < 2 {
            return names
        }
        var left: List[Text] = []
        var right: List[Text] = []
        for (i, name) in names.enumerate() {
            if i < names.len() / 2 {
                left.push(name)
            } else {
                right.push(name)
            }
        }
        let a = MemDir.sorted(left)
        let b = MemDir.sorted(right)
        var out: List[Text] = []
        var i = 0
        var j = 0
        while i < a.len() or j < b.len() {
            if j == b.len() or (i < a.len() and a[i] <= b[j]) {
                out.push(a[i])
                i += 1
            } else {
                out.push(b[j])
                j += 1
            }
        }
        return out
    }
}

// An operation that needs only `observes` permissions sees `self` through the observes-only
// view (REFERENCE §9.2), so the helpers take the files rather than `self`.
impl Dir for MemDir {
    fn read_text(self, path: Path) -> Text fails FsError {
        let file = try MemDir.file(files: self.files, given: path)
        return self.files.get(file) else fail FsError.NotFound(path: path)
    }

    fn write_text(self, path: Path, text: Text) fails FsError {
        let file = try MemDir.file(files: self.files, given: path)
        let _ = self.files.set(key: file, value: text)
    }

    fn size(self, path: Path) -> Int fails FsError {
        let file = try MemDir.file(files: self.files, given: path)
        let text = self.files.get(file) else fail FsError.NotFound(path: path)
        return text.byte_len()
    }

    /// Each entry once, in the order of the names' bytes, as the runtime's `Dir` gives them.
    fn list(self, path: Path) -> List[Path] fails FsError {
        let (dir, _, place) = try MemDir.find(files: self.files, given: path)
        match place {
            Place.File => fail FsError.Other(message: f"`{path.value}` is not a directory")
            Place.Through => fail FsError.Other(message: f"`{path.value}` goes through a file")
            Place.Missing => fail FsError.NotFound(path: path)
            Place.Orphan => fail FsError.NotFound(path: path)
            Place.Dir => {}
        }
        var seen: Map[Text, Bool] = [:]
        var names: List[Text] = []
        for (file, _) in self.files {
            let below = if dir.value.is_empty() { Some(file.value) } else { file.value.strip_prefix(f"{dir.value}/") }
            if below is Some(rest) and not rest.is_empty() {
                let name = if rest.split_once("/") is Some((first, _)) { first } else { rest }
                if seen.set(key: name, value: true) is None {
                    names.push(name)
                }
            }
        }
        var out: List[Path] = []
        for name in MemDir.sorted(names) {
            out.push(if dir.value.is_empty() { Path(name) } else { Path(f"{dir.value}/{name}") })
        }
        return out
    }

    /// A directory with no files is held by a key that is its path and a `/`, which no file's
    /// path in normal form ends with.
    fn create_dir(self, path: Path) fails FsError {
        let (dir, _, place) = try MemDir.find(files: self.files, given: path)
        match place {
            Place.File => fail FsError.Other(message: f"`{path.value}` already exists")
            Place.Dir => fail FsError.Other(message: f"`{path.value}` already exists")
            Place.Through => fail FsError.Other(message: f"`{path.value}` goes through a file")
            Place.Orphan => fail FsError.NotFound(path: path)
            Place.Missing => {
                let _ = self.files.set(key: Path(f"{dir.value}/"), value: "")
            }
        }
    }

    fn remove(self, path: Path) fails FsError {
        let (target, dir, place) = try MemDir.find(files: self.files, given: path)
        check not target.value.is_empty() else fail FsError.PermissionDenied(path: path)
        match place {
            // A path that names a directory never removes a file.
            Place.File if dir => fail FsError.Other(message: f"`{path.value}` is not a directory")
            Place.File => {
                let _ = self.files.remove(target)
            }
            Place.Dir => {
                let marker = Path(f"{target.value}/")
                for (file, _) in self.files {
                    check file == marker or not file.value.starts_with(marker.value)
                        else fail FsError.Other(message: f"`{path.value}` is not empty")
                }
                let _ = self.files.remove(marker)
            }
            Place.Through => fail FsError.Other(message: f"`{path.value}` goes through a file")
            Place.Missing => fail FsError.NotFound(path: path)
            Place.Orphan => fail FsError.NotFound(path: path)
        }
        // The directory it was in stays, though it may now hold no file.
        let parent = MemDir.parent(target)
        if not parent.is_empty() {
            let _ = self.files.set(key: Path(f"{parent}/"), value: "")
        }
    }
}
