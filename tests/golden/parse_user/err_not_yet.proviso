fn text_later(t: Text) {
    let parts = t.split(",")                        // <- E0901
    let cs = t.chars()                              // <- E0901
    let at = t.find("a")                            // <- E0901
    let back = t.find_last("a")                     // <- E0901
    let mid = t.slice(from: at, to: back)           // <- E0901
    let norm = t.normalize_nfc()                    // <- E0901
    let raw = Text.from_utf8(t)                     // <- E0901
}
