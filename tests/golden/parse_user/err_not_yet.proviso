// phase: 2.5
// expect-error: E0901
// `lines` returns a `List`, which comes with collections later in phase 2. So do `for`
// loops that destructure, and implementations for tuple types, which are generic. The
// integer conversions of REFERENCE §12.1 other than `parse`, `test` blocks and `expect`
// statements aren't implemented yet either. Uses of what they produce aren't reported
// again (§15.1).
interface Shape {
    fn sides(self) -> Int
}

impl Shape for (Int, Int) {                         // <- E0901
    fn sides(self) -> Int {
        return 2
    }
}

fn later(t: Text) -> Int {
    let rows = t.lines()                             // <- E0901
    let n = rows.len()
    let narrow = Int32.try_from(5)                  // <- E0901
    let wrapped = Int8.wrapping_from(300)           // <- E0901
    for (i, x) in 0..3 {                            // <- E0901
    }
    return narrow
}

test "not yet" {                                    // <- E0901
    expect later("a") == 1
}

fn expects() {
    expect 1 == 1                                   // <- E0901
}
