// phase: 2.5
// flags: --incomplete
// expect-error: E0703
// expect-error: E0707
// A `todo` hole stands for a value of any type, so where one is in a function, an error type
// that settled as `Never` may be one a call fails with. `else`, `attempt` and an example's
// `fails` are not reported there as marking a call that can't fail, also where a `let`
// holds the hole (Q25; OPEN_QUESTIONS P5, `fails Never`; issue #30). A hole may be the
// `Option` an `else` unwraps. A `try` without `fails` is wrong whatever fills the hole, and a
// function without a hole is still checked.

fn rethrow[E: Copy](e: E) -> Int fails E {
    fail e
}

fn stop() -> Never {
    loop {
    }
}

fn holes(c: Bool) -> Int {
    let h1 = rethrow(e: todo) else 0
    let h2 = attempt rethrow(e: todo)
    let h3 = rethrow(e: todo)
    let h4 = todo
    let h5 = rethrow(e: h4) else 0
    let h6 = todo else 0
    return h1 + h3 + h5 + h6
}

fn holes_try() -> Int {
    let t1 = try rethrow(e: todo)                   // <- E0703
    return t1
}

fn no_holes() -> Int {
    let n1 = rethrow(e: stop()) else 0              // <- E0707
    return n1
}

example rethrow(e: todo) fails _
