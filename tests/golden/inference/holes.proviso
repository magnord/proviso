// phase: 2.5
// flags: --incomplete
// expect-error: E0707
// A `todo` hole stands for a value of any type, so an error type that only a hole reaches
// may be one a call fails with. `else`, `attempt`, `try` and an example's `fails` on such a
// call are not reported as marking a call that can't fail (Q25; OPEN_QUESTIONS P5, `fails
// Never`; issue #30). One that `Never` alone reaches still is.
fn rethrow[E: Copy](e: E) -> Int fails E {
    fail e
}

fn stop() -> Never {
    loop {
    }
}

fn holes(c: Bool) -> Int {
    let h1 = rethrow(e: todo) else 0
    let h2 = attempt rethrow(e: todo)
    let h3 = try rethrow(e: todo)
    let h4 = rethrow(e: todo)
    let h5 = if c { rethrow(e: todo) else 0 } else { rethrow(e: stop()) else 0 } // <- E0707
    return h1 + h3 + h4 + h5
}

example rethrow(e: todo) fails _
