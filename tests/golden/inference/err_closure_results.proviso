// phase: 3.1
// expect-error: E0301
// expect-error: E0603
// A closure's body gives its result, which must fit the function type it is checked as,
// directly or through a join, in either order (REFERENCE §9.2). A body that returns can't
// be a `fn() -> Never`, and a capability with fewer permissions can't be the result of a
// function type that promises more.
cap interface Log observes(read) effects(append) {
    fn read(self) -> Text                       needs read
    fn append(self, line: Text)                 needs append
}

fn takes_never(h: fn() -> Never) -> Int {
    return 0
}

fn takes_int(h: fn() -> Int) -> Int {
    return 1
}

fn returns(flag: Bool) -> Int {
    let a = takes_never(|| 5)                                           // <- E0301
    let b = takes_never(|| {
        let x = 1
        x                                                               // <- E0301
    })
    let c = if flag { takes_never } else { takes_int }
    let d = if flag { takes_int } else { takes_never }
    return a + b + c(|| 5) + d(|| 5)                                    // <- E0301, E0301
}

fn full_log(make: fn(take Log[read]) -> Log) -> Int {
    return 0
}

fn narrowed() -> Int {
    return full_log(|l| l)                                              // <- E0603
}
