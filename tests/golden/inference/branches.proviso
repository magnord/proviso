// phase: 2.5
// The branches of an `if` and the arms of a `match` give each other their type arguments
// and literal types, in any order (OPEN_QUESTIONS P5; issue #10). Each group is one value
// and its rewrites: swapped branches, a qualified or bare constructor, a branch that binds
// its value first, an `else if`, and the same value inside a tuple. Every rewrite checks,
// and passing it on shows its type, apart from `b9`, whose `Some(1)` nothing makes an
// `Int8`. Branches that only `Never` reaches give `Never`, so `n3` and `n4` are
// `Option[Never]`s.
use std.io { IoError }

fn opt(x: Option[Int]) -> Option[Int] {
    return x
}

fn opt8(x: Option[Int8]) -> Option[Int8] {
    return x
}

fn int8(x: Int8) -> Int8 {
    return x
}

fn pair8(x: (Int8, Option[Int8])) -> (Int8, Option[Int8]) {
    return x
}

fn variants(c: Bool) -> Text {
    let a1 = if c { Some(1) } else { None }
    let a2 = if c { None } else { Some(1) }
    let a3 = if c { Option.None } else { Option.Some(1) }
    let a4 = if c { None } else if c { None } else { Some(1) }
    let a5 = if c { None } else {
        let one = 1
        Some(one)
    }
    let a6 = match c {
        true => None
        false => Some(1)
    }
    let a7 = match c {
        true => Some(1)
        false => None
    }
    return f"{opt(a1)} {opt(a2)} {opt(a3)} {opt(a4)} {opt(a5)} {opt(a6)} {opt(a7)}"
}

fn literals(c: Bool, small: Int8) -> Text {
    let b1 = if c { small } else { 1 }
    let b2 = if c { 1 } else { small }
    let b3 = if c { 1 } else if c { 2 } else { small }
    let b4 = match c {
        true => 1
        false => small
    }
    let b5 = if c { Some(1) } else { Some(small) }
    let b6 = if c { None } else { Some(small) }
    let b7 = if c { (1, None) } else { (small, Some(small)) }
    let b8 = if c { (small, Some(small)) } else { (1, None) }
    let b9 = if c { (small, None) } else { (1, Some(1)) }
    return f"{int8(b1) + int8(b2) + int8(b3) + int8(b4)} {opt8(b5)} {opt8(b6)} {pair8(b7)} {pair8(b8)} {b9}"
}

fn nevers(c: Bool) -> Text fails Text {
    let n1 = if c { Some(fail "x") } else { Some(1) }
    let n2 = if not c { Some(1) } else { Some(fail "x") }
    let n3 = if c { Some(fail "x") } else { None }
    let n4 = if not c { None } else { Some(fail "x") }
    let n5: Option[Never] = n3
    return f"{opt(n1)} {opt(n2)} {n4 == n5}"
}

pub fn main(sys: keep System) fails IoError {
    try sys.stdout.write_line(variants(true))
    try sys.stdout.write_line(variants(false))
    try sys.stdout.write_line(literals(c: true, small: 5))
    try sys.stdout.write_line(literals(c: false, small: 5))
    try sys.stdout.write_line(f"{attempt nevers(false)}")
}
