// phase: 2.5
// expect-error: E0201
// expect-error: E0301
// expect-error: E0303
// expect-error: E0701
// expect-error: E0702
// expect-error: E0703
// expect-error: E0705
// expect-error: E0706
// expect-error: E0707
// expect-error: E0708
// An error type that only `Never` gives is `Never`, so the call can't fail, whether `::[…]`
// gives it or the arguments do (OPEN_QUESTIONS P5, `fails Never`). Marking it with `try`
// is E0703, also where the function has a `fails` of its own, with `attempt` E0706, with
// `else` E0707, and an example of its failure is E0708. An error type that a rejected value
// also reached is that value's error, so the call can still fail, and a `try` chain with a
// call that didn't resolve may have held one that fails (REFERENCE §15.1; issue #30). Two
// calls of one chain that fail with the same type are one E0702. A `fail` leaves, also
// where nothing declares `fails`, so its `Never` gives an error type as any `Never` does,
// and the mistakes it shares a line with are their own. A method on a call's result settles
// its receiver's type, so a call's error type joins what its handler knows when it marks the
// call. Under `try` that is the function's `fails`. Under the other handlers it is the chain's
// first fallible call, or else the `Result` an `attempt` is expected to be. A value that gives it after the chain comes too
// late, as `== Err(…)` after it and `else it` do, though `Err(…) ==` before it gives the
// `Result` the `attempt` is expected to be (P5, `fails Never`; issue #37). A call that was
// rejected doesn't keep a `try` from checking its other calls against the function's `fails`,
// or keep a handler's chain from reporting its own mistakes.

record Box {
    n: Int
}

fn boxof[E: Copy](e: E) -> Box fails E {
    return Box(n: 1)
}

impl Box {
    fn pick[E: Copy](self, e: E) -> Int fails E {
        return self.n
    }

    fn wrap[E: Copy](self, e: E) -> Option[E] fails E {
        return None
    }
}

fn wrapped[E: Copy](e: E) -> Option[E] fails E {
    return None
}

fn stop() -> Never {
    loop {
    }
}

fn rethrow[E: Copy](e: E) -> Int fails E {
    fail e
}

fn two[E: Copy](a: E, b: Option[E]) -> Int fails E {
    return 1
}

fn rejected() -> Int {
    let a1 = try two(a: stop(), b: 5)               // <- E0301
    let a2 = two(a: stop(), b: 5)                   // <- E0701, E0301
    let a3 = try boxof(e: stop()).pick(e: nosuch)   // <- E0201
    let a4 = try boxof(e: stop()).missing()         // <- E0303
    let a5 = try boxof(e: nosuch).pick(e: stop())   // <- E0201
    let a6 = try boxof(e: nosuch).pick(e: 6)        // <- E0201, E0702
    return 0
}

fn rejected_declared() -> Int fails Text {
    let a7 = try boxof(e: nosuch).pick(e: 7)        // <- E0201, E0702
    let a8 = try boxof(e: 8).pick(e: nosuch)        // <- E0702, E0201
    return 0
}

fn rejected_handled() -> Int {
    let a9 = attempt boxof(e: nosuch).wrap(e: 9).missing() // <- E0201, E0303
    let b1 = boxof(e: nosuch).wrap(e: 1).missing() else 0  // <- E0201, E0303
    return 0
}

fn same_errors() -> Int {
    let b1 = try boxof(e: 5).pick(e: 6)             // <- E0702
    return 0
}

fn same_declared() -> Int fails Text {
    let b2 = try boxof(e: 5).pick(e: 6)             // <- E0702
    return 0
}

fn declared() -> Int fails Text {
    let c1 = try rethrow::[Never](e: stop())        // <- E0703
    let c2 = try boxof::[Never](e: stop()).pick(e: "c2")
    let c3 = try rethrow(e: stop())
    return 0
}

fn handled() -> Int {
    let d1 = attempt rethrow(e: stop())             // <- E0706
    let d2 = rethrow(e: stop()) else 0              // <- E0707
    let d3 = attempt rethrow::[Never](e: stop())    // <- E0706
    let d4 = rethrow::[Never](e: stop()) else 0     // <- E0707
    let d5: Result[Int, Text] = attempt rethrow(e: stop())
    let d6 = rethrow(e: stop()) else it
    let d7 = rethrow::[Never](e: stop())
    return 0
}

fn rejected_fails() -> Int {
    let f1 = rethrow(e: fail "f1") else 0           // <- E0705, E0707
    let f2 = attempt rethrow(e: fail "f2")          // <- E0705, E0706
    let f3 = try rethrow(e: fail "f3")              // <- E0705, E0703
    return f1
}

fn chained() -> Int fails Text {
    let g1 = try wrapped(e: stop()).show()
    let g2 = try boxof(e: "g2").wrap(e: stop()).show()
    let g3 = try boxof(e: stop()).wrap(e: stop()).show()
    let g4 = try boxof(e: "g4").wrap(e: stop()).show().byte_len()
    let g5 = try wrapped::[Never](e: stop()).show() // <- E0703
    return 0
}

fn chained_handled() -> Int {
    let k1 = attempt boxof(e: "k1").wrap(e: stop()).show()
    let k2 = attempt boxof(e: stop()).wrap(e: "k2").show()
    let k3 = boxof(e: "k3").wrap(e: stop()).show() else "k3"
    let k4: Result[Text, Text] = attempt wrapped(e: stop()).show()
    let k5: Result[Int, Text] = attempt boxof(e: stop()).wrap(e: stop()).show().byte_len()
    let k6 = attempt wrapped(e: stop()).show()      // <- E0706
    let k7 = attempt wrapped(e: stop()).show() == Err("k7") // <- E0706
    let k8 = wrapped(e: stop()).show() else it      // <- E0707
    let k9 = Err("k9") == attempt wrapped(e: stop()).show()
    return 0
}

example boxof(e: "x").wrap(e: stop()).show() fails _
example boxof(e: nosuch).wrap(e: 2).missing() fails _ // <- E0201, E0303
example rethrow(e: fail "f4") fails _              // <- E0705, E0708
example rethrow(e: stop()) fails _                  // <- E0708
example rethrow::[Never](e: stop()) fails _         // <- E0708
