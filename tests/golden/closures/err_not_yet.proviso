// phase: 2.9
// expect-error: E0901
// Phase 6 brings `scoped fn` (REFERENCE §9.4, §6.7). `inout(partial)` parameters of function
// types, and an `impl` for a function type, are not scheduled. A closure passed as one checks
// its body without reporting what the rejected type would have given it (§15.1). `keep fn`
// parameters, `keep` parameters of function types and closures that change a `var` they
// capture came with retention (slice 3.7).
enum Stop {
    Halt
}

fn scoped_param(f: scoped fn()) {}                  // <- E0901

fn partial_mode(f: fn(inout(partial) Int) fails Stop) -> Int {  // <- E0901
    var m = 1
    let r = attempt f(&m)
    return m
}

fn partial_closure() -> Int {
    return partial_mode(f: |n| {
        n = 7
        fail Stop.Halt
    })
}

interface Named {
    fn name(self) -> Text
}

impl Named for fn() {                               // <- E0901
    fn name(self) -> Text {
        return "f"
    }
}
