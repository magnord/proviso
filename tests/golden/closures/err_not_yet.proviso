// phase: 2.9
// expect-error: E0901
// Reach comes with phase 3: `uses C` and `with E` on a function type, effect variables,
// `scoped fn` and `keep fn` parameters, and closures that capture a capability or a value
// that holds one (REFERENCE §9.4, §6.7). So do closures that change a `var` they capture
// (§5.3), and the operations of `List` and `Map` that take a closure, such as `map` and
// `filter`. `keep` and `inout(partial)` parameters of function types, and an `impl` for a
// function type, are not scheduled. A closure passed as one checks its body without
// reporting what the rejected type would have given it (§15.1).
use std.io { Out }

record Sink {
    out: Out
}

fn run(f: fn()) {
    f()
}

fn bump(n: inout Int) {
    n = n + 1
}

fn effectful(f: fn() uses Out) {}                   // <- E0901

fn effect_var(f: fn() with E) {}                    // <- E0901

fn scoped_param(f: scoped fn()) {}                  // <- E0901

fn keep_param(f: keep fn()) {}                      // <- E0901

fn mutate() {
    var n = 1
    run(f: || {
        n = 2                                       // <- E0901
    })
    var xs = [1]
    run(f: || xs.push(2))                           // <- E0901
    run(f: || bump(n: &n))                          // <- E0901
}

fn reach(out: Out, sink: Sink) {
    run(f: || {
        let _ = attempt out.write_line("x")         // <- E0901
    })
    run(f: || {
        let s = sink                                // <- E0901
    })
}

fn takes_out(o: Out) {}

fn reach_late(o: Out) {
    let f = |p| {
        run(f: || debug(p))                         // <- E0901
        takes_out(o: p)
    }
    f(o)
}

fn mapped(xs: List[Int]) {
    let ys = xs.map(f: |x| x + 1)                   // <- E0901
    let zs = xs.filter(f: |x| x > 1)                // <- E0901
}

resource record Held {
    out: Out
}

impl Held {
    fn close(take self) {}
}

impl Abandon for Held {
    fn abandon(take self) {}
}

fn reach_resource(h: take Held) {
    run(f: || h.close())                            // <- E0901
}

fn reach_generic[T, C: Copy](x: T, xs: List[T], c: C, ys: List[C]) {
    run(f: || debug(x))                             // <- E0901
    run(f: || debug(xs))                            // <- E0901
    run(f: || debug(c))
    run(f: || debug(ys))
}

fn reach_generic_late[T](x: T, g: fn(T)) {
    let f = |p| {
        run(f: || debug(p))                         // <- E0901
        g(p)
    }
    f(x)
}

enum Stop {
    Halt
}

fn keep_mode(f: fn(keep Out)) {}                    // <- E0901

fn partial_mode(f: fn(inout(partial) Int) fails Stop) -> Int {  // <- E0901
    var m = 1
    let r = attempt f(&m)
    return m
}

fn partial_closure() -> Int {
    return partial_mode(f: |n| {
        n = 7
        fail Stop.Halt
    })
}

interface Named {
    fn name(self) -> Text
}

impl Named for fn() {                               // <- E0901
    fn name(self) -> Text {
        return "f"
    }
}
