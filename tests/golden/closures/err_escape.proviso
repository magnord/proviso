// phase: 2.9
// expect-error: E0309
// expect-error: E0509
// A closure lives only until the call it is passed to returns, or as long as the local it is
// bound to (REFERENCE §6.7, OPEN_QUESTIONS Q34). Since retention (slice 3.7), a function type
// may appear anywhere a type may, as a field, a result, an error, an element, a type argument
// or a part of a tuple, written or inferred, and a `var` may be given a new function value.
// What may be stored there is decided by where the value comes from (P5). A block, a branch
// or an arm can't give a closure that captures a local declared inside it, or a binding of
// its `is` test or pattern, since the closure would outlive it (E0509). A function value
// isn't `Copy`, nor is a value that holds one (E0309). Each mistake is reported once, where
// the function value goes in, and not again at a value that holds it or a call that takes
// that value (REFERENCE §15.1).
use std.pool { Pool }

record Holder {
    f: fn(Int) -> Int
}

enum Stop {
    Halt
}

fn make() -> fn(Int) -> Int {
    unreachable
}

fn fails_with() fails fn() {
    unreachable
}

fn listed(xs: List[fn()]) {}

fn optional(o: Option[fn()]) {}

fn tupled(t: (fn(), Int)) {}

fn curried(f: fn() -> fn()) {}

fn higher(f: fn(fn(Int) -> Int) -> Int) -> Int {
    return f(|x| x)
}

fn generic[T](x: take T) -> T {
    return x
}

fn inferred(f: fn(Int) -> Int) {
    let xs = [f]
    let o = Some(f)
    let t = (f, 1)
    let g = generic(x: f)
    let m = ["k": f]
    let p: Pool[fn()] = Pool.new()
    let k = || f
    var h = f
    h = f
    let ok = f
}

fn escape_block(flag: Bool) -> Int {
    let base = 1
    let f = if flag {
        let local = 2
        |x: Int| x + local                          // <- E0509
    } else {
        |x: Int| x + base
    }
    let g = if flag {
        let inner = 3
        let add = |x: Int| x + inner
        add                                         // <- E0509
    } else {
        |x: Int| x
    }
    let h = if flag {
        let deep = 4
        match flag {                                // <- E0509
            true => |x: Int| x + deep
            false => |x: Int| x
        }
    } else {
        |x: Int| x
    }
    return f(1) + g(2) + h(3)
}

fn escape_pattern(o: Option[Int]) -> Int {
    let base = 1
    let f = if o is Some(n) {
        |x: Int| x + n                              // <- E0509
    } else {
        |x: Int| x + base
    }
    let g = match o {
        Some(n) => |x: Int| x + n                   // <- E0509
        None => |x: Int| x
    }
    let h = match o {
        Some(n) => {
            let m = n + 1
            |x: Int| x + m                          // <- E0509
        }
        None => |x: Int| x + base
    }
    let k = match o {
        Some(n) => |x: Int| x + base
        None => |x: Int| x
    }
    return f(1) + g(1) + h(1) + k(1)
}

fn some[T: Copy](x: T) -> Option[T] {
    return Some(x)
}

fn not_copy(f: fn(Int) -> Int) {
    let a = some(x: f)                              // <- E0309
    let e = some::[fn(Int) -> Int](x: f)            // <- E0309
    let b = some(x: Holder(f: f))                   // <- E0309
    let c = Some(Some(f))
}

fn qualified(f: fn(Int) -> Int, flag: Bool) -> Int {
    let a = Option.Some(f)
    let d = Option.Some(|x: Int| x)
    let g = if flag {
        let deep = 4
        Option.Some(|x: Int| x + deep)              // <- E0509
    } else {
        None
    }
    return 1
}
