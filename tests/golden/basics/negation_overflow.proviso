// phase: 1
// expect-exit: 70
// Negating the smallest `Int8` overflows, which is a defect (REFERENCE §12.1).
use std.io { IoError }

fn negate(x: Int8) -> Int8 {
    return -x
}

pub fn main(sys: keep System) fails IoError {
    let fine: Int8 = -127
    try sys.stdout.write_line(f"{negate(x: fine)}")
    let min: Int8 = -128
    try sys.stdout.write_line(f"{negate(x: min)}")
}
