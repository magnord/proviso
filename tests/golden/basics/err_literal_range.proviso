// phase: 1
// expect-error: E0302
// A literal takes the type it meets, and must fit it. `-128` fits in Int8; `-129` does not.
fn f() {
    let fits: Int8 = -128
    let byte: UInt8 = 256                           // <- E0302
    let low: Int8 = -129                            // <- E0302
    let max: UInt64 = 18446744073709551615
    let too_big = 9223372036854775808               // <- E0302
    let huge = 340282366920938463463374607431768211455   // <- E0302
    let tiny: Float32 = 1e39                        // <- E0302
}
