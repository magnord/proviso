// phase: 1
// expect-error: E0304
// Non-Unit functions end every path with an explicit `return`; there is no implicit value.
fn sign(n: Int) -> Int {
    if n < 0 {
        return -1
    } else if n > 0 {
        return 1
    }
}                                                   // <- E0304

fn double(n: Int) -> Int {
    n * 2                                           // <- E0304
}

fn pick(c: Bool) -> Int {
    if c { 1 } else { 2 }                           // <- E0304, E0304
}

fn ok(n: Int) -> Int {
    if n < 0 {
        return 0
    } else {
        return n
    }
}

fn forever() -> Int {
    loop {
    }
}

fn bound_forever() -> Int {
    let x: Int = loop {}
}

fn stops() -> Int {
    unreachable
}
