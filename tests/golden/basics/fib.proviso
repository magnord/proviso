// phase: 1
use std.io { IoError }

/// The nth Fibonacci number, recursively.
fn fib(n: Int) -> Int {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

/// The same, with a loop and reassignment.
fn fib_iter(n: Int) -> Int {
    var a = 0
    var b = 1
    for _i in 0..n {
        let next = a + b
        a = b
        b = next
    }
    return a
}

pub fn main(sys: keep System) fails IoError {
    for i in 0..=10 {
        try sys.stdout.write_line(f"fib({i}) = {fib(i)}")
    }
    try sys.stdout.write_line(f"fib_iter(90) = {fib_iter(90)}")
}
