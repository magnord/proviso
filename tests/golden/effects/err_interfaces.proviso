// phase: 3.6
// expect-error: E0210
// expect-error: E0307
// expect-error: E0314
// expect-error: E0701
// Generic interface methods aren't implemented, so no effect parameter is declared there for
// a `with` to name (REFERENCE §9.5). The method then fails with an unknown type, as one whose
// `fails` type is rejected does. An `impl` may declare its `fails` either way, and a call
// must still be marked (inference/err_try). Everything else about the method is checked
// (§15.1). A `cap interface`'s operation is the same. An `impl` method's `with` names an
// effect parameter of its own.
enum Bad {
    Oops
}

interface Fire {
    fn fire(self) with E                                // <- E0307
    fn both(self) fails Bad with E                      // <- E0307
    fn other(self, n: Nope) with E                      // <- E0307, E0307
    fn lost(self) fails Nope                            // <- E0307
    fn fire(self)                                       // <- E0210
}

cap interface Shoot {
    fn shoot(self) with E                               // <- E0307
}

record Gun {
    n: Int
}

impl Fire for Gun {
    fn fire(self) {}
    fn both(self) fails Bad {}
    fn other(self, n: Int) {}
    fn lost(self) {}
    fn extra(self) {}                                   // <- E0314
}

impl Gun {
    fn go(self) with E {}                               // <- E0307
}

record Box[T] {
    v: T
}

impl[T] Box[T] {
    fn each[effect E](self, f: fn(T) with E) with E {
        f(self.v)
    }

    fn bad(self) with T {}                              // <- E0307
}

fn calls(g: Gun) {
    try g.fire()
    g.both()                                            // <- E0701
    Box(v: 1).each(f: |x| {})
}
