// phase: 2.4
// expect-error: E0101
// expect-error: E0301
// expect-error: E0901
// A mistake inside an `impl` block or an interface is reported once (REFERENCE §15.1).
// Recovery skips the rest of the member's line and stops at the block's `}`, so the block
// isn't also reported as never closed. A block that loses a method this way isn't reported
// for lacking it, an `impl` may declare a method its interface lost, and calls of a lost
// method aren't reported. A broken visibility is reported once and skipped through its `)`
// or up to the item's keyword, so the item is still declared and checked, and its uses
// aren't reported.
interface Shape {
    fn area(self) -> Int
    fn sides(self) -> Int
}

interface Two {
    fn one(self) -> Int fn two(self) -> Int                 // <- E0101
}

interface Wide {
    fn width(self, x: Int                                   // <- E0101
}

interface Size { fn zero() -> Int }                         // <- E0901

record Box {
    n: Int
}

impl Shape for Box {
    fn area(self) -> Int { return 1 } fn sides(self) -> Int { return 4 }   // <- E0101
}

impl Box {
    fn a(self) -> Int { return 1 } fn b(self) -> Int { return 2 }          // <- E0101
}

impl Box { fn c(self) -> Int }                              // <- E0101

impl Box { fn e(self) -> Int { return 5 } fn f(self) -> Int { return 6 } }  // <- E0101

impl Box {
    fn d(self, x: Int                                       // <- E0101
}

impl Two for Box {
    fn one(self) -> Int {
        return 1
    }

    fn two(self) -> Int {
        return 2
    }
}

impl Wide for Box {
    fn width(self, x: Int) -> Int {
        return x
    }
}

record Crate {
    n: Int
}

pub(pkg impl Crate {                                        // <- E0101
    fn get(self) -> Int {
        return self.n
    }
}

pub(pkg fn helper() -> Int {                                // <- E0101
    return 1
}

pub(pkg record Thing {                                      // <- E0101
    n: Int
}

fn calls(b: Box, c: Crate, t: Thing) -> Int {
    let shape = b.area() + b.sides()
    let own = b.a() + b.b() + b.c() + b.d(x: 1) + b.e() + b.f()
    let ifaces = b.one() + b.two() + b.width(x: 2)
    return shape + own + ifaces + c.get() + helper() + t.n
}

pub(1) record Plank {                                       // <- E0101
    n: Int
}

pub(pkg] fn shaped() -> Int {                               // <- E0101
    return "shaped"                                         // <- E0301
}

impl Plank {
    pub(1) fn len(self) -> Int {                            // <- E0101
        return self.n
    }
}

fn more(p: Plank) -> Int {
    return p.len() + Plank(n: 1).n + shaped()
}
