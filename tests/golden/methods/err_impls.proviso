// phase: 2.4
// expect-error: E0303
// expect-error: E0307
// expect-error: E0313
// expect-error: E0314
// expect-error: E0315
// expect-error: E0316
// An `impl I for T` gives `T` exactly the methods `I` declares, each with the same receiver,
// parameters, return type and `fails`, reading `Self` as `T` (REFERENCE §4.9). A type
// implements an interface once, by `derives` or by one `impl`. An `impl` lives in the module
// of the interface or of the type, so this module can't implement the prelude's `Show` for
// `Int`. `Copy` holds by itself and can't be implemented by hand (§5.1). A type with a
// rejected `impl` still implements its interface, so calls of its methods aren't reported
// again (§15.1).
interface Shape {
    fn area(self) -> Int
    fn same(self, other: Self) -> Bool
}

interface Load {
    fn load(self, n: Int) -> Int fails Text
}

record Square {
    side: Int
}

record Circle {
    r: Int
}

record Tri {
    base: Int
}

record Blob derives(Show) {
    n: Int
}

impl Shape for Square {
    fn area(self) -> Int {
        return self.side * self.side
    }

    fn same(self, other: Square) -> Bool {
        return self.side == other.side
    }
}

impl Shape for Square {                             // <- E0313
    fn area(self) -> Int {
        return 0
    }

    fn same(self, other: Self) -> Bool {
        return true
    }
}

impl Shape for Circle {                             // <- E0314
    fn area(self) -> Int {
        return 3 * self.r * self.r
    }
}

impl Shape for Tri {
    fn area(self) -> Bool {                         // <- E0314
        return true
    }

    fn same(self, other: Square) -> Bool {          // <- E0314
        return false
    }
}

impl Load for Square {
    fn load(self, n: Int) -> Int {                  // <- E0314
        return n
    }
}

impl Load for Circle {
    fn load(self, n: Text) -> Int fails Text {      // <- E0314
        return 0
    }

    fn extra(self) -> Int {                         // <- E0303
        return 1
    }
}

impl Show for Blob {                                // <- E0313
    fn show(self) -> Text {
        return "blob"
    }
}

impl Show for Int {                                 // <- E0315
    fn show(self) -> Text {
        return "int"
    }
}

impl Copy for Square {                              // <- E0316
}

impl Shape for Ghost {                              // <- E0307
    fn area(self) -> Int {
        return 0
    }
}

impl Drawable for Square {                          // <- E0307
    fn draw(self) -> Int {
        return 0
    }
}

fn calls(s: Square, c: Circle, t: Tri, b: Blob) -> Int {
    let a = c.same(c) and t.same(t)
    let shown = f"{b} {s.draw()}"
    return c.area() + t.area() + s.area()
}
