// phase: 2.4
// A generic function's type parameters are inferred at each call, from the type the call
// is expected to have and then from the arguments, or given with `::[…]` (REFERENCE §4.8;
// OPEN_QUESTIONS P5). So a literal takes the type the call needs, and `id(100)` is an
// `Int8` where an `Int8` is expected. Constraints say what the body may do with a `T`. It
// orders it with `T: Ord`, shows it with `T: Show` and copies it with `T: Copy`. Calls
// between generic functions pass their parameters on. A parameter of interface type,
// `x: Show`, is a type parameter of its own (§4.9), so two of them may take different
// types. The `Ord` derive orders variants, then fields, in declaration order (STD.md), and
// `Option` does the same with the variants STD.md declares, so `Some(x) < None` (P5).
// Arguments that give a parameter its type without context are read before literals and
// variants, and variants with fields before other literals, so the order of arguments or
// operands doesn't change what a call infers. `value_or(r: Ok(100), d: small)` is a
// `Result[Int8, Text]`, and in `fallback_or(fallback: 9, o: Some(small))` the `9` is an
// `Int8`. A `fail` argument is `Never`, which gives way to the type the other arguments
// give (P5).
use std.io { IoError }

record Version derives(Eq, Ord, Hash, Show) {
    major: Int
    minor: Int
}

enum Level derives(Eq, Ord, Show) {
    Low
    Mid(n: Int)
    High
}

fn id[T: Copy](x: T) -> T {
    return x
}

fn largest[T: Ord + Copy](a: T, b: T) -> T {
    if a < b {
        return b
    }
    return a
}

fn show_largest[T: Ord + Copy + Show](a: T, b: T) -> Text {
    return f"{largest(a: a, b: b)}"
}

fn or_else[T: Copy](o: Option[T], fallback: T) -> T {
    return match o {
        Some(v) => v
        None => fallback
    }
}

fn fallback_or[T: Copy](fallback: T, o: Option[T]) -> T {
    return or_else(o: o, fallback: fallback)
}

fn nothing[T]() -> Option[T] {
    return None
}

fn value_or[T: Copy](r: Result[T, Text], d: T) -> T {
    return match r {
        Ok(v) => v
        Err(_) => d
    }
}

fn first_ok[T: Copy](o: Option[Result[T, Text]], d: T) -> T {
    return match o {
        Some(Ok(v)) => v
        _ => d
    }
}

fn is_some[T](o: Option[T]) -> Bool {
    return match o {
        Some(_) => true
        None => false
    }
}

fn both_some[T](a: Option[T], b: Option[T]) -> Bool {
    return is_some(a) and is_some(b)
}

fn stop_or_both(flag: Bool) -> Bool fails Text {
    if flag {
        return both_some(a: Some(fail "stopped"), b: Some(1))
    }
    return both_some(a: Some(2), b: nothing())
}

fn pair_text(a: Show, b: Show) -> Text {
    return f"{a}+{b}"
}

fn count_down[T: Show](x: T, n: Int) -> Text {
    if n == 0 {
        return f"{x}"
    }
    return f"{n} {count_down(x: x, n: n - 1)}"
}

pub fn main(sys: keep System) fails IoError {
    let small: Int8 = id(100)
    let t = id::[Int16](-300)
    try sys.stdout.write_line(f"{small} {id(3000000000)} {t} {id("text")} {id(Some('c'))}")
    let v1 = Version(major: 1, minor: 9)
    let v2 = Version(major: 2, minor: 0)
    let v3 = Version(major: 1, minor: 10)
    try sys.stdout.write_line(f"{largest(a: v1, b: v2)} {largest(a: v3, b: v1)} {v1 < v3} {v2 > v3} {largest(a: "pear", b: "apple")}")
    try sys.stdout.write_line(f"{Level.Low < Level.Mid(n: 0)} {Level.Mid(n: 5) < Level.Mid(n: 3)} {Level.High > Level.Mid(n: 99)} {largest(a: Level.High, b: Level.Low)}")
    let none: Option[Int] = nothing()
    try sys.stdout.write_line(f"{or_else(o: Some(4), fallback: 9)} {or_else(o: none, fallback: 9)} {nothing::[Text]()} {Some(1) < None} {largest(a: Some(2), b: None)}")
    let wide: Int16 = 5
    let o = Some(3)
    try sys.stdout.write_line(f"{value_or(r: Ok(1), d: 0)} {value_or(r: Err("bad"), d: 7)} {value_or(r: Ok(100), d: small)} {first_ok(o: Some(Ok(200)), d: wide)} {first_ok(o: Some(Err("no")), d: 3)} {first_ok(o: None, d: 4)} {fallback_or(fallback: 9, o: Some(small))}")
    try sys.stdout.write_line(f"{largest(a: 1, b: small)} {id(1) + small} {small + id(1)} {nothing() == o} {o == nothing()} {largest(a: None, b: Some(2))} {attempt stop_or_both(false)} {attempt stop_or_both(true)}")
    try sys.stdout.write_line(f"{pair_text(a: 1, b: "one")} {pair_text(a: v1, b: Level.Low)} {count_down(x: "hi", n: 2)} {show_largest(a: 'a', b: 'z')}")
}
