// phase: 2.4
// expect-error: E0204
// A method's name is snake_case (REFERENCE §2). A wrongly cased method stands for the name
// it misspells (§15.1), in an interface, in an `impl` of one and among a type's own methods
// and associated functions, so its uses aren't reported again.
interface Named {
    fn Name(self) -> Text                           // <- E0204
}

interface Sized {
    fn size(self) -> Int
}

record Tag {
    n: Int
}

impl Named for Tag {
    fn name(self) -> Text {
        return "tag"
    }
}

record Pen {
    n: Int
}

impl Sized for Pen {
    fn Size(self) -> Int {                          // <- E0204
        return 1
    }
}

record Brush {
    n: Int
}

impl Brush {
    fn Grip(self) -> Int {                          // <- E0204
        return 2
    }

    fn Make() -> Brush {                            // <- E0204
        return Brush(n: 0)
    }
}

fn calls(t: Tag, p: Pen, b: Brush) -> Int {
    let named = t.name()
    let made = Brush.make()
    return p.size() + b.grip() + made.n
}
