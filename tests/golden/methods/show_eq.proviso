// phase: 2.4
// A record or enum may implement the prelude's `Show` and `Eq` by hand (REFERENCE §4.9).
// Its `show` is what `show()`, interpolation and `Show.show(x)` produce, and also what a
// derived `Show` of a value holding it writes, such as a record's or an `Option`'s (STD.md;
// OPEN_QUESTIONS P5). Its `eq` decides `==`, `!=` and `eq()`, also inside a derived `Eq`,
// an `Option` and generic code. A derived `Eq` compares fields in declaration order and
// stops at the first that differs, so a later field's `eq` doesn't run (P5). `debug` writes
// a value's fields and never runs a hand-written `show` (P5).
use std.io { IoError }

record Span derives(Eq) {
    lo: Int
    hi: Int
}

impl Show for Span {
    fn show(self) -> Text {
        return f"[{self.lo}, {self.hi})"
    }
}

enum Suit {
    Hearts
    Spades
}

impl Show for Suit {
    fn show(self) -> Text {
        return match self {
            Hearts => "H"
            Spades => "S"
        }
    }
}

/// Tickets are the same ticket when their ids are, whatever their notes say.
record Ticket derives(Show) {
    id: Int
    note: Text
}

impl Eq for Ticket {
    fn eq(self, other: Self) -> Bool {
        return self.id == other.id
    }
}

record Booking derives(Eq, Show) {
    ticket: Ticket
    span: Span
}

/// Comparing two probes at level 100 overflows.
record Probe {
    level: Int8
}

impl Eq for Probe {
    fn eq(self, other: Self) -> Bool {
        return self.level * 2 == other.level * 2
    }
}

record Reading derives(Eq) {
    id: Int
    probe: Probe
}

enum Sample derives(Eq) {
    Taken(id: Int, probe: Probe)
    Skipped
}

fn same[T: Eq](a: T, b: T) -> Bool {
    return a == b
}

fn wrapped[T: Show](x: T) -> Text {
    return f"<{x}>"
}

pub fn main(sys: keep System) fails IoError {
    let s = Span(lo: 1, hi: 4)
    let r: Result[Int, Suit] = Err(Suit.Hearts)
    try sys.stdout.write_line(f"{s} {s.show()} {Show.show(s)} {wrapped(s)} {Suit.Spades} {r}")
    let a = Ticket(id: 7, note: "window")
    let b = Ticket(id: 7, note: "aisle")
    let c = Ticket(id: 8, note: "window")
    try sys.stdout.write_line(f"{a == b} {a != b} {a == c} {a.eq(b)} {Eq.eq(a, c)} {same(a: a, b: b)}")
    let x = Booking(ticket: a, span: s)
    let y = Booking(ticket: b, span: s)
    let z = Booking(ticket: a, span: Span(lo: 1, hi: 5))
    try sys.stdout.write_line(f"{x == y} {x == z} {same(a: Some(a), b: Some(b))} {Some(s)} {x}")
    let hot = Probe(level: 100)
    let first = Reading(id: 1, probe: hot)
    let second = Reading(id: 2, probe: hot)
    let taken = Sample.Taken(id: 1, probe: hot)
    try sys.stdout.write_line(f"{first == second} {Some(first) != Some(second)} {taken == Sample.Taken(id: 2, probe: hot)} {taken == Sample.Skipped}")
    debug(s, x)
}
