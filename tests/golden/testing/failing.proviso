// phase: 2.11
// run: test
// expect-exit: 70
// A failing `expect` ends its test, and the test's line names the `expect` that failed and
// why: `c` is false, or both values of an `expect … == v`, or what a call returned or failed
// with (REFERENCE §14). The tests after it still run. A defect in a test is reported on
// stderr, traced to the test, which is anchored by its name, and makes the exit code 70
// (OPEN_QUESTIONS P5). Each test has the example fuel. A failing `expect` is a failure exit,
// which abandons the resources the test holds (REFERENCE §10).
enum Stop derives(Eq, Show) {
    Halt
    Wait(seconds: Int)
}

fn stop(n: Int) -> Int fails Stop {
    if n > 0 {
        fail Stop.Wait(seconds: n)
    }
    return n
}

resource record Lock {
    id: Int
}

impl Lock {
    fn close(take self) {
    }
}

impl Abandon for Lock {
    fn abandon(take self) {
        debug(f"abandon {self.id}")
    }
}

fn forever(n: Int) -> Int {
    var i = 0
    while true {
        i += n
    }
    return i
}

test "a false condition" {
    let n = 3
    expect n > 2
    expect n * 2 == 7 or n < 0
    debug("not reached")
}

test "unequal values" {
    expect [1, 2] == [1, 3]
}

test "a call that fails" {
    expect stop(2) == 2
}

test "a call that returns" {
    expect stop(0) fails Stop.Halt
}

test "another error" {
    expect stop(5) fails Stop.Wait(seconds: 1)
}

test "a defect" {
    debug("before")
    let xs = [1]
    expect xs[3] == 1
}

test "out of fuel" {
    expect forever(1) == 0
}

test "a resource it holds" {
    let lock = Lock(id: 1)
    expect lock.id == 2
    lock.close()
}

test "passes" {
    expect stop(-1) == -1
}
