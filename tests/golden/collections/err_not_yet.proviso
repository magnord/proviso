// phase: 2.6
// expect-error: E0901
// What collections still lack is reported as not implemented, and what it would have
// given isn't reported again (§15.1). `Set` has no literal or constructor yet (OPEN_QUESTIONS
// Q37), and `Array` comes later in phase 2. The operations that take a closure wait for
// effect variables (STD.md), and implementations for generic types such as `List[Int]` for the
// rest of phase 2, so a method or interface such an implementation may give isn't reported
// missing (§15.1). STD.md declares no `swap` (§5.3) and none of the predicates of §8.1, and
// `split` is one of the `Text` functions of §12.3 it doesn't declare.
fn sets(s: Set[Int]) -> Int {                       // <- E0901
    return s.len()
}

fn arrays(a: Array[Int, 3]) -> Int {                // <- E0901
    return a.len()
}

fn built(xs: List[Int]) -> Int {
    let s = Set.new()                               // <- E0901
    let t = Set.from(xs)                            // <- E0901
    let a = Array.new()                             // <- E0901
    return s.len() + t.len() + a.len()
}

fn later(xs: List[Int], t: Text) -> Int {
    let doubled = xs.map(f: 2)                      // <- E0901
    let kept = xs.filter(f: 1)                      // <- E0901
    let sorted = xs.is_sorted()                     // <- E0901
    var ys = xs
    ys.swap(i: 0, j: 1)                             // <- E0901
    let parts = t.split(",")                        // <- E0901
    return doubled.len() + kept.len() + parts.len()
}

interface Named {
    fn name(self) -> Text
}

impl Named for List[Int] {                          // <- E0901
    fn name(self) -> Text {
        return "list"
    }
}

fn named(xs: List[Int]) -> Text {
    let n = xs.name()
    let m = Named.name(xs)
    return n
}
