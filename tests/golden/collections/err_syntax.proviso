// phase: 2.6
// expect-error: E0101
// expect-error: E0102
// A broken literal or index is one error at the token that breaks it, and the next
// statement still parses. A `[` that a trailing comma leaves open is reported at the
// bracket, as an unclosed `(` is (OPEN_QUESTIONS P5). A literal or an index alone is an
// unused value (REFERENCE §2), with no other error, even when nothing gives it a type, as
// for a bare `None` (§15.1). Uses of a binding whose value failed to parse report nothing.
fn broken(xs: List[Int]) -> Int {
    let a = [1, 2: 3]                                // <- E0101
    let b = ["k": 1, 2]                              // <- E0101
    let c = [1 2]                                    // <- E0101
    let d = xs[]                                     // <- E0101
    let e = xs[0, 1]                                 // <- E0101
    return a.len() + b.len() + c.len() + d + e
}

fn unclosed() -> Int {
    let a = [1,                                      // <- E0101
    let b = 2
    return b
}

fn bare(xs: List[Int]) {
    []                                               // <- E0102
    [:]                                              // <- E0102
    [[]]                                             // <- E0102
    ["k": None]                                      // <- E0102
    ([], 1)                                          // <- E0102
    (None, 1)                                        // <- E0102
    xs[0]                                            // <- E0102
}
