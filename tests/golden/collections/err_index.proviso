// phase: 2.6
// expect-error: E0106
// expect-error: E0301
// expect-error: E0305
// expect-error: E0306
// expect-error: E0309
// `xs[i]` indexes a list with an `Int` (STD.md). Only a list has an index: a map has `get`,
// text is never indexed by integers (REFERENCE §12.3), and a tuple is taken apart by a
// pattern. Reading `xs[i]` copies the element, so it needs `T: Copy`. Assigning through an
// index needs a `var` at the root, as assigning a field does, and only a variable and its
// fields and elements can be assigned (OPEN_QUESTIONS P5).
fn indexing(xs: List[Int], m: Map[Text, Int], t: Text, small: Int8, p: (Int, Int)) -> Int {
    let a = xs[small]                                // <- E0301
    let b = xs["0"]                                  // <- E0301
    let c = m["k"]                                   // <- E0306
    let d = t[0]                                     // <- E0306
    let e = p[0]                                     // <- E0306
    let f = small[0]                                 // <- E0306
    let g = xs[0][1]                                 // <- E0306
    return xs[1]
}

fn assigning(xs: List[Int]) {
    xs[0] = 1                                        // <- E0305
    let ys = [1, 2]
    ys[0] = 5                                        // <- E0305
    var zs = [1, 2]
    zs[0] = "five"                                   // <- E0301
    zs["0"] = 5                                      // <- E0301
    zs[0] += "a"                                     // <- E0301
    [1, 2][0] = 3                                    // <- E0106
    var words = ["a"]
    words[0] += "b"                                  // <- E0306
    var m = ["k": 1]
    m["k"] = 2                                       // <- E0306
}

fn generic[T](xs: List[T]) -> Int {
    let x = xs[0]                                    // <- E0309
    return 1
}

fn copied[T: Copy](xs: List[T], grid: List[List[T]]) -> T {
    let row = grid[0]
    let x = row[0]
    return xs[0]
}

fn borrowed[T](grid: List[List[T]]) -> Int {
    let n = grid[0].len()
    let m = grid[0][0]                               // <- E0309
    let row = grid[1]                                // <- E0309
    return n
}
