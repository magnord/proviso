// phase: 2.2
// expect-error: E0903
// Exhaustiveness can take exponential work. These arms make the check split on every field,
// both ways, so it gives up after its step limit and says so rather than run for minutes
// (OPEN_QUESTIONS P5). The arms do cover every value.

record Flags {
    f0: Bool
    f1: Bool
    f2: Bool
    f3: Bool
    f4: Bool
    f5: Bool
    f6: Bool
    f7: Bool
    f8: Bool
    f9: Bool
    f10: Bool
    f11: Bool
    f12: Bool
    f13: Bool
    f14: Bool
    f15: Bool
    f16: Bool
    f17: Bool
    f18: Bool
    f19: Bool
    f20: Bool
    f21: Bool
    f22: Bool
    f23: Bool
}

fn count(flags: Flags) -> Int {
    return match flags {                            // <- E0903
        Flags(f0: true, ..) => 0
        Flags(f0: false, ..) => 0
        Flags(f1: true, ..) => 1
        Flags(f1: false, ..) => 1
        Flags(f2: true, ..) => 2
        Flags(f2: false, ..) => 2
        Flags(f3: true, ..) => 3
        Flags(f3: false, ..) => 3
        Flags(f4: true, ..) => 4
        Flags(f4: false, ..) => 4
        Flags(f5: true, ..) => 5
        Flags(f5: false, ..) => 5
        Flags(f6: true, ..) => 6
        Flags(f6: false, ..) => 6
        Flags(f7: true, ..) => 7
        Flags(f7: false, ..) => 7
        Flags(f8: true, ..) => 8
        Flags(f8: false, ..) => 8
        Flags(f9: true, ..) => 9
        Flags(f9: false, ..) => 9
        Flags(f10: true, ..) => 10
        Flags(f10: false, ..) => 10
        Flags(f11: true, ..) => 11
        Flags(f11: false, ..) => 11
        Flags(f12: true, ..) => 12
        Flags(f12: false, ..) => 12
        Flags(f13: true, ..) => 13
        Flags(f13: false, ..) => 13
        Flags(f14: true, ..) => 14
        Flags(f14: false, ..) => 14
        Flags(f15: true, ..) => 15
        Flags(f15: false, ..) => 15
        Flags(f16: true, ..) => 16
        Flags(f16: false, ..) => 16
        Flags(f17: true, ..) => 17
        Flags(f17: false, ..) => 17
        Flags(f18: true, ..) => 18
        Flags(f18: false, ..) => 18
        Flags(f19: true, ..) => 19
        Flags(f19: false, ..) => 19
        Flags(f20: true, ..) => 20
        Flags(f20: false, ..) => 20
        Flags(f21: true, ..) => 21
        Flags(f21: false, ..) => 21
        Flags(f22: true, ..) => 22
        Flags(f22: false, ..) => 22
        Flags(f23: true, ..) => 23
        Flags(f23: false, ..) => 23
    }
}
