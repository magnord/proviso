// phase: 3.5
// `MemDir` reads a path as the runtime's `Dir` does, so a test that passes against it
// behaves the same against `sys.fs` (REFERENCE §9.6, OPEN_QUESTIONS P5). The same calls run
// against both, and only the outcomes that differ are printed. A path that goes through a
// file, ends in `/` or `/.`, climbs with `..` or is absolute fails the same way in both. The
// one difference is a directory with no files, which a `MemDir` can't hold, since its files
// are its one `state` field (§9.6).
use std.fs { Dir, Path, FsError }
use std.test { MemDir }
use std.io { Out }

fn outcome[T: Show](result: Result[T, FsError]) -> Text {
    return match result {
        Ok(value) => f"ok {value}"
        Err(error) => f"{error}"
    }
}

fn done(result: Result[Unit, FsError]) -> Text {
    return match result {
        Ok(_) => "ok"
        Err(error) => f"{error}"
    }
}

fn reads(dir: Dir, path: Path) -> List[Text] {
    return [outcome(attempt dir.read_text(path)), outcome(attempt dir.size(path)), outcome(attempt dir.list(path))]
}

fn compare(what: Text, real: List[Text], fake: List[Text], out: Out) -> Int {
    var differ = 0
    for (i, r) in real.enumerate() {
        if r != fake[i] {
            out.write_line(f"{what} #{i}: runtime {r}, MemDir {fake[i]}") else {}
            differ += 1
        }
    }
    return differ
}

pub fn main(sys: keep System) fails FsError {
    let real = sys.fs
    let fake = MemDir.with_files([:])
    var differ = 0
    for dir in [real, fake] {
        try dir.write_text(path: Path("f"), text: "file")
        try dir.create_dir(Path("d"))
        try dir.write_text(path: Path("d/a"), text: "a")
        try dir.write_text(path: Path("./d//b"), text: "bb")
    }
    let paths = ["", ".", "f", "f/", "f/.", "f/x", "f/x/y", "./f", "d", "d/", "d/.", "d/a", "d//a", "d/../f",
        "d/a/..", "nope", "d/nope", "nope/x", "/f", "../f", "d/../../f", "/"]
    for p in paths {
        differ += compare(what: f"read {p}", real: reads(dir: real, path: Path(p)), fake: reads(dir: fake, path: Path(p)), out: sys.stdout)
    }
    for p in paths {
        let w = [done(attempt real.write_text(path: Path(p), text: "w")), done(attempt fake.write_text(path: Path(p), text: "w"))]
        differ += compare(what: f"write {p}", real: [w[0]], fake: [w[1]], out: sys.stdout)
    }
    for p in ["f", "f/x", "d", "d/new", "d/new/", "f/new", "/x", "../x", "d/a"] {
        let c = [done(attempt real.create_dir(Path(p))), done(attempt fake.create_dir(Path(p)))]
        differ += compare(what: f"create {p}", real: [c[0]], fake: [c[1]], out: sys.stdout)
    }
    for p in ["f/x", "d", "d/", "nope", "", ".", "d/..", "/f", "../f", "d/new", "d/a", "d/b", "nope/", "d", "f/"] {
        let r = [done(attempt real.remove(Path(p))), done(attempt fake.remove(Path(p)))]
        differ += compare(what: f"remove {p}", real: [r[0]], fake: [r[1]], out: sys.stdout)
    }
    differ += compare(what: "final", real: reads(dir: real, path: Path("")), fake: reads(dir: fake, path: Path("")), out: sys.stdout)
    sys.stdout.write_line(f"{differ} outcomes differ") else {}
}
