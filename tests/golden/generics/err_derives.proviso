// phase: 2.10
// expect-error: E0306
// expect-error: E0309
// A generic type that derives an interface implements it only for type arguments that do,
// so `==`, interpolation, a map key and a constraint all need the type arguments it holds to
// implement the interface too (REFERENCE §4.4, §4.8; OPEN_QUESTIONS P5). A field whose type
// isn't generic must implement the derived interface itself.
record Plain {
    n: Int
}

record Pair[A, B] derives(Eq, Ord, Hash, Show) {
    first: A
    second: B
}

enum Slot[T] derives(Eq, Show) {
    Full(value: T)
    Vacant
}

record Fixed[T] derives(Eq, Show) {
    plain: Plain                                    // <- E0309, E0309
    value: T
}

fn largest[T: Ord + Copy](a: T, b: T) -> T {
    return a
}

fn derived(p: Pair[Plain, Int], s: Slot[Float], q: Pair[Int, Slot[Plain]]) -> Bool {
    let a = p == p                                  // <- E0306
    let b = f"{s}"
    let c = s == s                                  // <- E0306
    let d = f"{q}"                                  // <- E0306
    let e = largest(a: q, b: q)                     // <- E0309
    let f: Map[Pair[Int, Float], Int] = [:]         // <- E0309
    let g = [Slot.Full(1.5): 1]                     // <- E0309
    let h = Pair(first: 1, second: 2) == Pair(first: 1, second: 2)
    let i = Slot.Full(Pair(first: 1, second: 'c')) == Slot.Vacant
    return h and i
}
