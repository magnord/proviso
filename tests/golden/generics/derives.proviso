// phase: 2.10
// A generic type that derives an interface implements it for the type arguments that do,
// so `Pair[Int, Text]` is `Ord` and a map key, and `Pair[Plain, Int]` isn't `Eq` (REFERENCE
// §4.4; OPEN_QUESTIONS P5). Only the type arguments it holds count, so `Phantom[Plain]` is
// `Eq`. A derived `Ord` orders variants, then fields, in declaration order, whatever the type
// arguments are (STD.md).
use std.io { IoError }

record Pair[A, B] derives(Eq, Ord, Hash, Show) {
    first: A
    second: B
}

enum Tree[T] derives(Eq, Ord, Hash, Show) {
    Leaf
    Node(left: Tree[T], value: T, right: Tree[T])
}

record Plain {
    n: Int
}

record Phantom[T] derives(Eq, Show) {
    n: Int
}

fn largest[T: Ord + Copy](a: T, b: T) -> T {
    if a < b {
        return b
    }
    return a
}

fn leaf[T](value: take T) -> Tree[T] {
    return Tree.Node(left: Tree.Leaf, value: value, right: Tree.Leaf)
}

pub fn main(sys: keep System) fails IoError {
    let a = Pair(first: 1, second: "b")
    let b = Pair(first: 2, second: "a")
    let c = Pair(first: 1, second: "a")
    try sys.stdout.write_line(f"{a < b} {a < c} {c <= a} {largest(a: a, b: c)} {largest(a: b, b: a)}")
    let m = [a: 1, b: 2, c: 3, a: 4]
    try sys.stdout.write_line(f"{m.len()} {m.get(a)} {m.get(Pair(first: 9, second: "z"))}")
    let t: Tree[Int] = Tree.Leaf
    try sys.stdout.write_line(f"{t < leaf(value: 0)} {leaf(value: 1) < leaf(value: 2)} {largest(a: leaf(value: "x"), b: Tree.Leaf)}")
    let trees = [leaf(value: Pair(first: 1, second: 'a')): "one", Tree.Leaf: "none"]
    try sys.stdout.write_line(f"{trees.get(Tree.Leaf)} {trees.get(leaf(value: Pair(first: 1, second: 'a')))}")
    let p: Phantom[Plain] = Phantom(n: 1)
    let q: Phantom[Plain] = Phantom(n: 2)
    try sys.stdout.write_line(f"{p == q} {p == p} {q}")
    let nested = Pair(first: Pair(first: 1, second: 2), second: leaf(value: [1, 2]))
    try sys.stdout.write_line(f"{nested < nested.with(second: leaf(value: [1, 3]))} {nested}")
}
