// phase: 2.10
// expect-exit: 70
// expect-report: defect refinement_failed
// A `with` in a generic function checks the refinement of the generic record it builds,
// whatever its type arguments are, before anything assigns to the copy (REFERENCE §4.4,
// §8.3).
record Tagged[T] {
    lo: Int
    hi: Int
    label: T
} where lo <= hi

fn widen[T: Copy](t: Tagged[T], by: Int) -> Tagged[T] {
    var u = t.with(hi: t.hi + by)
    u.lo = u.lo - 10
    return u
}

pub fn main(sys: keep System) {
    let a = widen(t: Tagged(lo: 1, hi: 4, label: [1]), by: 2)
    let b = widen(t: Tagged(lo: 0, hi: 0, label: Some('x')), by: -1)
}
