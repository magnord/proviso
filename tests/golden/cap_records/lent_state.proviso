// phase: 3.3
// An `&` argument from a `state` field lends the field to the call (OPEN_QUESTIONS P5). One
// lent field may give several places, at different indices. A callee that can't fail changes
// the value in place, so a loop of such calls stays linear. One that fails leaves the field as
// it was, unless its parameter keeps partial changes (REFERENCE §5.4). Meanwhile the object's
// other methods may run, and a failure in one rolls back the fields it changed, but not the lent
// one, whose change is still the outer call's.
use std.io { IoError }

enum Full {
    At(n: Int)
}

cap record Bag {
    limit: Int
    state items: List[Int]
    state calls: Int
}

fn add(xs: inout List[Int], x: Int) {
    xs.push(x)
}

fn swap(a: inout Int, b: inout Int) {
    let t = a
    a = b
    b = t
}

fn add_checked(xs: inout List[Int], x: Int, limit: Int) fails Full {
    xs.push(x)
    check xs.len() <= limit else fail Full.At(n: xs.len())
}

fn add_partial(xs: inout(partial) List[Int], x: Int, limit: Int) fails Full {
    xs.push(x)
    check xs.len() <= limit else fail Full.At(n: xs.len())
}

impl Bag {
    fn fill(self, n: Int) {
        for i in 0..n {
            add(xs: &self.items, x: i)
        }
    }

    fn swap_ends(self) {
        swap(a: &self.items[0], b: &self.items[1])
    }

    fn checked(self, x: Int) -> Text {
        let a = attempt add_checked(xs: &self.items, x: x, limit: self.limit)
        let b = attempt add_partial(xs: &self.items, x: x, limit: self.limit)
        return f"{a is Ok(_)} {b is Ok(_)} {self.items.len()}"
    }

    fn count(self) {
        self.calls += 1
    }

    fn count_then_fail(self) fails Full {
        self.calls += 100
        fail Full.At(n: self.calls)
    }

    fn add_counting(self, xs: inout List[Int], x: Int) fails Full {
        xs.push(x)
        self.count()
        let _ = attempt self.count_then_fail()
    }

    fn nested(self) fails Full {
        try self.add_counting(xs: &self.items, x: 7)
    }

    fn report(self) -> Text {
        return f"{self.items.len()} items, first {self.items[0]}, last {self.items[self.items.len() - 1]}, {self.calls} calls"
    }
}

pub fn main(sys: keep System) fails IoError {
    let bag = Bag(limit: 100001, items: [], calls: 0)
    bag.fill(n: 100000)
    bag.swap_ends()
    try sys.stdout.write_line(bag.report())
    try sys.stdout.write_line(bag.checked(x: 5))
    try sys.stdout.write_line(bag.checked(x: 6))
    let nested = attempt bag.nested()
    try sys.stdout.write_line(f"{nested is Ok(_)}")
    try sys.stdout.write_line(bag.report())
}
