// phase: 3.3
// A chain of a million capability objects, each holding the next in a plain field and some
// `state` of its own, goes away without recursion, as a long enum does (OPEN_QUESTIONS P5).
// A `state` field can't hold the next object, which could make a cycle.
use std.io { IoError }

cap record Node {
    next: Option[Node]
    state depth: Int
    state seen: List[Int]
}

impl Node {
    fn depth(self) -> Int {
        return self.depth
    }
}

pub fn main(sys: keep System) fails IoError {
    var chain: Option[Node] = None
    for i in 0..1000000 {
        chain = Some(Node(next: chain, depth: i, seen: [i]))
    }
    let depth = match chain {
        Some(node) => node.depth(),
        None => 0,
    }
    try sys.stdout.write_line(f"built {depth}")
    chain = None
    try sys.stdout.write_line("dropped")
}
