// phase: 3.3
// A chain of a million capability objects, each holding the next in a plain field and some
// `state` of its own, goes away without recursion, as a long enum does (OPEN_QUESTIONS P5).
// A `state` field can't hold the next object, which could make a cycle. Whether it could is
// found in linear time, also for a type that doubles at each of 40 aliases, since the checker
// shares each part of its type (OPEN_QUESTIONS P5).
use std.io { IoError }

type D0 = Int
type D1 = (D0, D0)
type D2 = (D1, D1)
type D3 = (D2, D2)
type D4 = (D3, D3)
type D5 = (D4, D4)
type D6 = (D5, D5)
type D7 = (D6, D6)
type D8 = (D7, D7)
type D9 = (D8, D8)
type D10 = (D9, D9)
type D11 = (D10, D10)
type D12 = (D11, D11)
type D13 = (D12, D12)
type D14 = (D13, D13)
type D15 = (D14, D14)
type D16 = (D15, D15)
type D17 = (D16, D16)
type D18 = (D17, D17)
type D19 = (D18, D18)
type D20 = (D19, D19)
type D21 = (D20, D20)
type D22 = (D21, D21)
type D23 = (D22, D22)
type D24 = (D23, D23)
type D25 = (D24, D24)
type D26 = (D25, D25)
type D27 = (D26, D26)
type D28 = (D27, D27)
type D29 = (D28, D28)
type D30 = (D29, D29)
type D31 = (D30, D30)
type D32 = (D31, D31)
type D33 = (D32, D32)
type D34 = (D33, D33)
type D35 = (D34, D34)
type D36 = (D35, D35)
type D37 = (D36, D36)
type D38 = (D37, D37)
type D39 = (D38, D38)
type D40 = (D39, D39)

cap record Node {
    next: Option[Node]
    state depth: Int
    state seen: List[Int]
    state wide: Option[D40]
}

impl Node {
    fn depth(self) -> Int {
        return self.depth
    }
}

pub fn main(sys: keep System) fails IoError {
    var chain: Option[Node] = None
    for i in 0..1000000 {
        chain = Some(Node(next: chain, depth: i, seen: [i], wide: None))
    }
    let depth = match chain {
        Some(node) => node.depth(),
        None => 0,
    }
    try sys.stdout.write_line(f"built {depth}")
    chain = None
    try sys.stdout.write_line("dropped")
}
