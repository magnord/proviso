// phase: 3.7
// A call whose receiver holds a closure that changes a captured `var` restores the `var` when
// it fails, as for an `inout` argument (REFERENCE §5.4, OPEN_QUESTIONS P5 "Changed captures").
use std.io { IoError }

enum Stop {
    Halt
}

record Counter {
    bump: fn()
}

impl Counter {
    fn run(self) fails Stop {
        let b = self.bump
        b()
        fail Stop.Halt
    }

    fn twice(self, x: inout Int) {
        x += 100
        let b = self.bump
        b()
        x += 1000
    }
}

pub fn main(sys: keep System) fails IoError {
    var n = 0
    let c = Counter(bump: || { n += 1 })
    let _ = attempt c.run()
    try sys.stdout.write_line(f"n={n}")
}
