// phase: 3.7
// A closure that reads a `var` may be made in an index of a place, or in an argument after an
// `&` place or an `inout` receiver, since it runs before the place is changed (OPEN_QUESTIONS
// P5 "Assignment order", "Exclusivity").
use std.io { IoError }

fn last(f: fn() -> Int) -> Int {
    return f() - 1
}

fn set(xs: inout List[Int], i: Int) {
    xs[i] = 0
}

pub fn main(sys: keep System) fails IoError {
    var ws = [1, 2]
    ws.push(last(f: || ws.len()))
    try sys.stdout.write_line(f"{ws.len()}")
    var xs = [1, 2, 3]
    xs[last(f: || xs.len())] = 5
    try sys.stdout.write_line(f"{xs[2]}")
    var ys = [[1, 2], [3, 4]]
    set(xs: &ys[last(f: || ys.len())], i: 0)
    try sys.stdout.write_line(f"{ys[1][0]}")
    var zs = [[1, 2], [3, 4]]
    zs[last(f: || zs.len())].push(7)
    try sys.stdout.write_line(f"{zs[1].len()}")
    var us = [[1, 2], [3, 4]]
    set(xs: &us[0], i: last(f: || us.len()))
    try sys.stdout.write_line(f"{us[0][1]}")
    var vs = [[1, 2], [3, 4]]
    vs[0].push(last(f: || vs.len()))
    try sys.stdout.write_line(f"{vs[0].len()}")
}
