// phase: 3.7
// expect-error: E0509
// expect-error: E0607
// A default closure sees a captured `var` as it is when the closure runs, so its body is
// checked with whatever the `var` may hold by then, also a value assigned after the closure
// is made (OPEN_QUESTIONS P5). Each mistake is reported where the value goes out, in the
// closure's body.
use std.io { Out, IoError }

fn keep_out(out: keep Out, into: inout List[Out]) {
    into.push(out)
}

fn leak_fn(k: keep fn() -> Int, into: inout List[fn() -> Int]) {
    var n = 41
    var g = k
    let push = || into.push(g)                      // <- E0509
    g = || {
        n += 1
        n
    }
    push()
}

fn leak_out(out: Out, k: keep Out, into: inout List[Out]) {
    var o = k
    let push = || into.push(o)                      // <- E0607
    o = out
    push()
}

fn leak_kept(out: Out, k: keep Out, into: inout List[Out]) {
    var o = k
    let send = || keep_out(out: o, into: &into)     // <- E0607
    o = out
    send()
}

pub fn main(sys: keep System) fails IoError {
    var fs: List[fn() -> Int] = []
    leak_fn(k: || 0, into: &fs)
    for f in fs {
        try sys.stdout.write_line(f"{f()} {f()}")
    }
    var outs: List[Out] = []
    leak_out(out: sys.stderr, k: sys.stdout, into: &outs)
    leak_kept(out: sys.stderr, k: sys.stdout, into: &outs)
    for o in outs {
        try o.write_line("hi")
    }
}
