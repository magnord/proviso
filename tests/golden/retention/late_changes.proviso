// phase: 3.7
// A closure that changes a `var` may be made and called in an index of a place of that `var`,
// which it changes before the place is reached (OPEN_QUESTIONS P5 "Assignment order").
use std.io { IoError }

fn zero(f: fn()) -> Int {
    f()
    return 0
}

pub fn main(sys: keep System) fails IoError {
    var xs = [1, 2, 3]
    xs[zero(f: || { xs.push(9) })] = 5
    try sys.stdout.write_line(f"{xs[0]} {xs.len()}")
}
