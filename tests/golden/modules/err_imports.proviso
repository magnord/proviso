// phase: 3.4
// expect-error: E0205
// expect-error: E0213
// expect-error: E0203
// A `use` names a module and items that it exports with `pub` (REFERENCE §3). A module
// that doesn't exist, or an item the module doesn't declare, is E0205. An item the module
// keeps private is E0213, such as the capability interfaces of `System`'s fields, which
// `std.prelude` declares and no module exports yet (STD.md). The prelude's own items are
// in scope already, so importing one shadows it (H4). A rejected import brings in nothing,
// so the uses of its names report nothing more (§15.1).
use std.io { Out, Writer }                                  // <- E0205
use std.prelude { Net }                                     // <- E0213
use std.prelude { Option }                                  // <- E0203
use std.nowhere { Thing }                                   // <- E0205
use mylib.things                                            // <- E0205
use std.text { ParseError }

fn write(o: Out, w: Writer) -> Int {
    let x = Writer(1)
    return 1
}

fn reach(n: Net[connect], t: Thing) -> Int {
    let made = Thing.make()
    return 1
}

fn parse(text: Text) -> Int fails ParseError {
    return try Int.parse(text)
}
