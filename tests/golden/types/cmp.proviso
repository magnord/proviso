// phase: 2.11
// `cmp` returns the prelude's `Ordering`: `Less`, `Equal` or `Greater` (STD.md). Every type
// that implements `Ord` has it: the integers, `Char` and `Text`, a derived `Ord` on a record,
// enum or distinct type, a generic type, a collection, a tuple, `Option`, `Result`, a type
// parameter `T: Ord`, and an alias of any of them. `Ord.cmp(a, b)` calls it on `a`. A
// hand-written `impl Ord` defines `cmp`, and then `<`, the derived `Ord` of a type that holds
// it, and the order of two maps keyed by it use it (OPEN_QUESTIONS P5). `Ordering` derives
// `Eq`, `Ord`, `Hash` and `Show`, ordered as declared. `cmp` borrows both values, so a unique
// one doesn't move.
use std.io { IoError }

type Count = Int
type Rank = distinct Int derives(Eq, Ord, Show)

record Version derives(Eq, Hash, Show) {
    major: Int
    label: Text
}

// Compares by `major` alone, newest first, so `label` is ignored.
impl Ord for Version {
    fn cmp(self, other: Self) -> Ordering {
        return other.major.cmp(self.major)
    }
}

record Release derives(Eq, Ord, Show) {
    version: Version
    day: Int
}

enum Level derives(Eq, Ord, Show) {
    Low
    High(boost: Int)
}

unique record Ticket derives(Eq, Ord, Show) {
    seat: Int
}

record Pair[A, B] derives(Eq, Ord, Show) {
    first: A
    second: B
}

fn largest[T: Ord + Copy](a: T, b: T) -> T {
    match a.cmp(b) {
        Ordering.Less => return b
        _ => return a
    }
}

fn word(o: Ordering) -> Text {
    return match o {
        Less => "less"
        Equal => "equal"
        Greater => "greater"
    }
}

pub fn main(sys: keep System) fails IoError {
    let c: Count = 2
    try sys.stdout.write_line(f"{1.cmp(2)} {c.cmp(2)} {'b'.cmp('a')} {"ab".cmp("b")} {Int8(3).cmp(-3)}")
    try sys.stdout.write_line(f"{Level.Low.cmp(Level.High(boost: 0))} {Level.High(boost: 2).cmp(Level.High(boost: 1))}")
    try sys.stdout.write_line(f"{Rank(1).cmp(Rank(1))} {largest(a: Rank(4), b: Rank(9))} {Ord.cmp(Rank(2), Rank(1))}")
    let p = Pair(first: 1, second: "b")
    try sys.stdout.write_line(f"{p.cmp(Pair(first: 1, second: "a"))} {[1, 2].cmp([1, 3])} {(1, 'x').cmp((1, 'x'))}")
    let none: Option[Int] = None
    let err: Result[Int, Text] = Err("e")
    try sys.stdout.write_line(f"{Some(1).cmp(none)} {err.cmp(Ok(5))}")
    let old = Version(major: 1, label: "old")
    let new = Version(major: 2, label: "new")
    try sys.stdout.write_line(f"{old.cmp(new)} {old < new} {largest(a: old, b: new)} {Ord.cmp(new, old)}")
    let a = Release(version: old, day: 1)
    let b = Release(version: new, day: 9)
    try sys.stdout.write_line(f"{a.cmp(b)} {a > b} {Some(old) < Some(new)} {[new] < [old]}")
    let lt = Ordering.Less
    try sys.stdout.write_line(f"{lt == Ordering.Less} {lt < Ordering.Greater} {Ordering.Greater.cmp(Ordering.Equal)} {word(o: 3.cmp(3))}")
    let order = |x: Int, y: Int| x.cmp(y)
    let counts = [Ordering.Less: 1, Ordering.Equal: 2]
    try sys.stdout.write_line(f"{order(5, 1)} {counts.get(Ordering.Equal)} {largest(a: Ordering.Less, b: Ordering.Equal)}")
    let t = Ticket(seat: 2)
    let u = Ticket(seat: 3)
    try sys.stdout.write_line(f"{t.cmp(u)} {Ord.cmp(u, t)} {t < u} {t}")
    // Sorted newest first, `low`'s first key is `5` and `high`'s is `3`.
    let low = [Version(major: 1, label: "a"): 0, Version(major: 5, label: "a"): 0]
    let high = [Version(major: 2, label: "a"): 0, Version(major: 3, label: "a"): 0]
    try sys.stdout.write_line(f"{low.cmp(high)} {low < high} {high.cmp(low)}")
}
