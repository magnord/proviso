// phase: 2.3
// expect-error: E0901
// The `else` forms, `it` and `check` come in a later slice of phase 2. Uses of what they
// declare aren't reported again (REFERENCE §15.1).
fn risky(n: Int) -> Int fails Text {
    return n
}

fn later(o: Option[Int], n: Int) -> Int fails Text {
    let a = o else 0                                // <- E0901
    let b = risky(1) else fail it                   // <- E0901
    check n > 0 else fail "small"                   // <- E0901
    return n
}
