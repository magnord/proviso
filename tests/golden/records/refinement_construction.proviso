// phase: 2.1
// expect-exit: 70
// expect-report: defect refinement_failed
// Building a value that breaks a field's refinement is a defect (OPEN_QUESTIONS P3).
record User {
    name: Text where not name.is_empty()
    age: Int where 0 <= age and age < 150
}

fn make(age: Int) -> User {
    return User(name: "bob", age: age)
}

pub fn main(sys: keep System) {
    let ok = make(age: 149)
    let bad = make(age: 150)
}
