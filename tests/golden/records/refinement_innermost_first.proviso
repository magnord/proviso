// phase: 2.1
// expect-exit: 70
// expect-report: defect refinement_failed
// An assignment that breaks every record on its path reports the innermost one, which is
// checked first (OPEN_QUESTIONS P5).
record Span {
    lo: Int
    hi: Int
} where lo <= hi

record Window {
    span: Span
    limit: Int
} where span.lo <= limit

pub fn main(sys: keep System) {
    var w = Window(span: Span(lo: 1, hi: 4), limit: 3)
    w.span.lo = 5
}
