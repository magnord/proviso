// phase: 2.1
// expect-error: E0901
// Records that are generic, unique, opaque or resources, the `Ord` and `Hash` derives, and
// a record's generated validator come in later slices of phase 2. Uses of their names aren't
// reported again.
record Pair[A, B] {                                 // <- E0901
    first: A
    second: B
}

unique record Token {                               // <- E0901
    id: Int
}

resource record Lock {                              // <- E0901
    id: Int
}

opaque record Secret {                              // <- E0901
    id: Int
}

record Ranked derives(Eq, Ord) {                    // <- E0901
    n: Int
}

record Keyed derives(Hash) {                        // <- E0901
    n: Int
}

record Span {
    lo: Int
    hi: Int
} where lo <= hi

fn validated(lo: Int, hi: Int) -> Int {
    let s = Span.validate(lo: lo, hi: hi)           // <- E0901
    return 0
}

fn later_types(t: Token, l: Lock, s: Secret, p: Pair) -> Int {
    return 0
}
