// phase: 2.1
// expect-error: E0901
// A record's generated validator comes with the verifier in phase 5. Uses of what they declare aren't reported again (REFERENCE §15.1).
unique record Token {
    id: Int
}

record Span {
    lo: Int
    hi: Int
} where lo <= hi

fn validated(lo: Int, hi: Int) -> Int {
    let s = Span.validate(lo: lo, hi: hi)           // <- E0901
    return 0
}

fn later_types(t: Token) -> Int {
    return 0
}

cap record Counter {
    n: Int
}

record Holder {
    c: Counter
}

fn later_declarations(c: Counter, h: Holder) -> Int {
    return 0
}
