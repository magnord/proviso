// phase: 2.1
// expect-error: E0901
// Generic records, a record's generated validator and distinct types come in later slices
// of phase 2, and capability declarations and the rest of `System` in phase 3. Uses of what they declare aren't reported again (REFERENCE §15.1).
record Pair[A, B] {                                 // <- E0901
    first: A
    second: B
}

unique record Token {
    id: Int
}

record Span {
    lo: Int
    hi: Int
} where lo <= hi

fn validated(lo: Int, hi: Int) -> Int {
    let s = Span.validate(lo: lo, hi: hi)           // <- E0901
    return 0
}

fn later_types(t: Token, p: Pair, q: Pair[Int, Int]) -> Int {
    return 0
}

cap interface Logger {                              // <- E0901
    fn log(self, t: Text)
}

cap record Counter {                                // <- E0901
    n: Int
}

distinct type Meters = Int                          // <- E0901

record Holder {
    l: Logger
    c: Counter
    m: Meters
}

fn later_declarations(l: Logger, c: Counter, m: Meters, h: Holder) -> Int {
    return 0
}

fn system(sys: System) {
    let a = sys.stderr                              // <- E0901
    let b = sys.with(stderr: sys.stdout)            // <- E0901
    let c = System(stdout: sys.stdout)              // <- E0901
}
