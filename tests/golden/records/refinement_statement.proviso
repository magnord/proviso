// phase: 2.1
// expect-exit: 70
// expect-report: defect refinement_failed
// A construction is a call, so it may be a statement (REFERENCE §2, H3), and it still checks
// the refinements of what it builds.
record Span {
    lo: Int
    hi: Int
} where lo <= hi

pub fn main(sys: keep System) {
    let s = Span(lo: 1, hi: 2)
    Span(lo: 1, hi: 2)
    s.with(hi: 3)
    s.with(hi: 0)
}
