// phase: 2.1
// expect-exit: 70
// expect-report: defect integer_overflow
// A defect inside a refinement is traced back to the construction or assignment that
// checked it, as a defect in a function is traced to its call (OPEN_QUESTIONS P5).
record Sum {
    a: Int8
    b: Int8
} where a + b < 100

fn build(x: Int8) -> Sum {
    return Sum(a: x, b: x)
}

pub fn main(sys: keep System) {
    let ok = build(x: 10)
    let bad = build(x: 100)
}
